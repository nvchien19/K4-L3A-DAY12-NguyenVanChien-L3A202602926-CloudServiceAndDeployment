# File này quyết định thứ KHÔNG được gửi vào build context.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secret — tuyệt đối không được nướng vào image
.env
.env.*
*.pem
*.key

# VCS & môi trường dev
.git
.gitignore
.github
.venv
venv
env

# Python
__pycache__
*.py[cod]
.pytest_cache
*.egg-info
.mypy_cache

# Tài liệu, test, ảnh — image không cần
tests
screenshots
docs
*.md
*.log

# Docker & hệ điều hành
Dockerfile
docker-compose.yml
.idea
.vscode
.DS_Store
Thumbs.db
